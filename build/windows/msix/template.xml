<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="vrcdn-lowlatency-player.exe"
        Arguments=""
        InstallLocation="C:\Program Files\VRCDN Low Latency Player contributors\VRCDN Low Latency Player">
    </Installer>
    <PackageInformation
        PackageName="VRCDN Low Latency Player"
        PackageDisplayName="VRCDN Low Latency Player"
        PublisherName="CN=VRCDN Low Latency Player contributors"
        PublisherDisplayName="VRCDN Low Latency Player contributors"
        Version="0.1.0.0"
        PackageDescription="Low-latency audio player for VRCDN streams">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.vrcdn-lowlatency-player"
                Description="Low-latency audio player for VRCDN streams"
                DisplayName="VRCDN Low Latency Player"
                ExecutableName="vrcdn-lowlatency-player.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>VRCDN Low Latency Player</DisplayName>
            <PublisherDisplayName>VRCDN Low Latency Player contributors</PublisherDisplayName>
            <Description>Low-latency audio player for VRCDN streams</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="vrcdn-lowlatency-player.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>

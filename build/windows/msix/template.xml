<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="partyline.exe"
        Arguments=""
        InstallLocation="C:\Program Files\PartyLine for VRCDN contributors\PartyLine for VRCDN">
    </Installer>
    <PackageInformation
        PackageName="PartyLine for VRCDN"
        PackageDisplayName="PartyLine for VRCDN"
        PublisherName="CN=PartyLine for VRCDN contributors"
        PublisherDisplayName="PartyLine for VRCDN contributors"
        Version="0.1.0.0"
        PackageDescription="Low-latency audio player for VRCDN streams">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.partyline"
                Description="Low-latency audio player for VRCDN streams"
                DisplayName="PartyLine for VRCDN"
                ExecutableName="partyline.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>PartyLine for VRCDN</DisplayName>
            <PublisherDisplayName>PartyLine for VRCDN contributors</PublisherDisplayName>
            <Description>Low-latency audio player for VRCDN streams</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="partyline.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
